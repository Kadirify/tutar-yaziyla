{
  "name": "tutar-yaziyla",
  "version": "1.0.0",
  "description": "Sayıları ve para tutarlarını Türkçe yazıya çevirir: fatura, makbuz, çek ve senet için.",
  "keywords": [
    "sayı yazıyla",
    "tutar yazıyla",
    "yazıyla",
    "fatura",
    "çek",
    "senet",
    "türk lirası",
    "number to words",
    "turkish"
  ],
  "homepage": "https://github.com/Kadirify/tutar-yaziyla#readme",
  "bugs": {
    "url": "https://github.com/Kadirify/tutar-yaziyla/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kadirify/tutar-yaziyla.git"
  },
  "license": "MIT",
  "author": "Kadir",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "tutar-yaziyla": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
